NEXT_PUBLIC_APP_NAME=Fanora Protocol
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Create a project at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional dedicated RPC endpoints. Public RPCs are used when left empty.
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz

# Add addresses only after deploying the badge contract on each chain.
NEXT_PUBLIC_BADGE_CONTRACT_ADDRESS_MONAD_TESTNET=
NEXT_PUBLIC_BADGE_CONTRACT_ADDRESS_MONAD=
