# Fanora 前端公开环境变量模板。NEXT_PUBLIC_ 变量会进入浏览器，严禁填写任何私钥或服务端密钥。

# 前端显示的应用名称。示例：Fanora Protocol
NEXT_PUBLIC_APP_NAME=Fanora Protocol
# 前端站点完整地址，用于跳转和回调。示例：http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Fanora 后端 API 地址。示例：http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# WalletConnect Cloud Project ID；用于 RainbowKit 展示 WalletConnect、Rainbow 等移动钱包。示例：abc123...
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Privy Dashboard 的 App ID；填写后 /login 会优先展示 Privy 登录。示例：clxxxxxxxxxxxx
NEXT_PUBLIC_PRIVY_APP_ID=
# Monad Testnet RPC 地址，供登录钱包和交易请求使用。示例：https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Monad Mainnet RPC 地址，主网上线后使用。示例：https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
# FanoraMembershipGateway 测试网部署地址。示例：0x1234...abcd
NEXT_PUBLIC_MEMBERSHIP_PAYMENT_CONTRACT_ADDRESS_MONAD_TESTNET=
# FanoraMembershipIdentity 测试网部署地址。示例：0x2345...bcde
NEXT_PUBLIC_MEMBERSHIP_IDENTITY_CONTRACT_ADDRESS_MONAD_TESTNET=
# FanoraCollectibles 测试网部署地址。示例：0x3456...cdef
NEXT_PUBLIC_COLLECTIBLES_CONTRACT_ADDRESS_MONAD_TESTNET=
