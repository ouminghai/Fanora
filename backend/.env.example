# Fanora 后端环境变量模板。复制为 .env 后按实际环境修改，所有私钥和密钥都不要提交到 Git。

# 应用名称，用于接口文档和日志标识。示例：Fanora API
APP_NAME=Fanora API
# 应用版本号。示例：0.2.0
VERSION=0.2.0
# 运行环境，可选 development、staging、production。示例：development
ENVIRONMENT=development
# 是否开启调试信息，生产环境必须设为 false。示例：true
DEBUG=true
# 后端 API 统一前缀。示例：/api/v1
API_PREFIX=/api/v1
# 允许跨域访问后端的前端地址，多个地址使用英文逗号分隔。示例：http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 内部服务调用密钥，仅服务间接口使用。示例：openssl rand -hex 32 生成的字符串
INTERNAL_API_KEY=
# Web3Auth Dashboard 中创建项目后获得的 Client ID，必须与前端一致。示例：BICxTe9...YiOf8r88
WEB3AUTH_CLIENT_ID=BICxTe9MSpkkwRIrgNGa8cGgksO4VvNiBHqt694T88J_WecKTHn474CmkEtFvaOqfE0CxrtZUmUoZCPYiOf8r88
# Web3Auth 身份令牌公钥地址，一般无需修改。示例：https://api-auth.web3auth.io/jwks
WEB3AUTH_JWKS_URL=https://api-auth.web3auth.io/jwks
# Web3Auth 身份令牌签发方，一般无需修改。示例：https://api-auth.web3auth.io
WEB3AUTH_ISSUER=https://api-auth.web3auth.io
# 允许使用 Web3Auth 外部钱包登录的连接器名称。示例：metamask,wallet-connect-v2,coinbase
WEB3AUTH_EXTERNAL_ISSUERS=metamask,wallet-connect-v2,coinbase
# 钱包登录挑战的有效秒数。示例：300
AUTH_CHALLENGE_TTL_SECONDS=300
# Fanora 登录会话的有效秒数，604800 为 7 天。示例：604800
AUTH_SESSION_TTL_SECONDS=604800

# 主数据库连接地址；部署环境建议使用 PostgreSQL。示例：postgresql+psycopg://fanora:password@db:5432/fanora
DATABASE_URL=sqlite+aiosqlite:///./fanora.db
# 数据库连接池常驻连接数。示例：5
DATABASE_POOL_SIZE=5
# 数据库连接池允许临时增加的连接数。示例：10
DATABASE_MAX_OVERFLOW=10
# 等待数据库连接的最长秒数。示例：60
DATABASE_POOL_TIMEOUT_SECONDS=60
# 连接复用前的回收秒数。示例：300
DATABASE_POOL_RECYCLE_SECONDS=300
# 建立数据库连接的超时秒数。示例：60
DATABASE_CONNECT_TIMEOUT_SECONDS=60
# TCP keepalive 空闲秒数。示例：30
DATABASE_KEEPALIVE_IDLE_SECONDS=30
# TCP keepalive 探测间隔秒数。示例：10
DATABASE_KEEPALIVE_INTERVAL_SECONDS=10
# TCP keepalive 最大失败探测次数。示例：3
DATABASE_KEEPALIVE_COUNT=3
# 是否在本地启动时自动创建表；生产环境建议通过迁移管理。示例：true
AUTO_CREATE_SCHEMA=true
# 启动时执行数据库迁移的最大重试次数。示例：5
MIGRATION_MAX_ATTEMPTS=5
# 数据库迁移失败后的重试等待秒数。示例：2
MIGRATION_RETRY_DELAY_SECONDS=2

# LangGraph 检查点数据库地址，留空则不启用持久化。示例：postgresql://fanora:password@db:5432/fanora_checkpoints
CHECKPOINT_DATABASE_URL=
# LangGraph 检查点数据库连接池大小。示例：5
CHECKPOINT_POOL_SIZE=5
# 是否自动初始化 LangGraph 检查点表。示例：false
CHECKPOINT_AUTO_SETUP=false

# Valkey/Redis 地址，用于缓存和分布式限流，留空则使用进程内实现。示例：redis://localhost:6379/0
CACHE_URL=
# 默认缓存有效秒数。示例：60
CACHE_TTL_SECONDS=60
# 本地 Grafana 管理员密码，生产环境必须替换。示例：请使用密码管理器生成强密码
GRAFANA_ADMIN_PASSWORD=change-this-local-password

# OpenAI 或兼容服务的 API Key。示例：sk-proj-...；不要提交真实值
OPENAI_API_KEY=
# OpenAI 兼容服务地址，使用官方服务时可留空。示例：https://api.openai.com/v1
OPENAI_BASE_URL=
# 默认大模型名称。示例：gpt-5-mini
OPENAI_MODEL=
# 备用模型列表，多个模型使用英文逗号分隔。示例：gpt-5-mini,gpt-4.1-mini
OPENAI_FALLBACK_MODELS=
# 模型生成温度，越低越稳定。示例：0.2
LLM_TEMPERATURE=0.2
# 单次模型回复最大 token 数。示例：1200
LLM_MAX_TOKENS=1200
# 模型请求最大重试次数。示例：3
LLM_MAX_RETRIES=3
# 单次模型任务总超时秒数。示例：60
LLM_TOTAL_TIMEOUT_SECONDS=60
# 徽章草稿生成所需最小 token 预算。示例：500
BADGE_DRAFT_MIN_TOKENS=500

# 是否启用 Langfuse 链路追踪。示例：false
LANGFUSE_ENABLED=false
# Langfuse Public Key。示例：pk-lf-...；未启用时留空
LANGFUSE_PUBLIC_KEY=
# Langfuse Secret Key。示例：sk-lf-...；未启用时留空
LANGFUSE_SECRET_KEY=
# Langfuse 服务地址。示例：https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# Monad RPC 节点地址。示例：https://testnet-rpc.monad.xyz
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Monad Testnet 链 ID。示例：10143
MONAD_CHAIN_ID=10143
# 合约提现最终接收资金的钱包地址，不是私钥。示例：0x1234...abcd
MEMBERSHIP_TREASURY_ADDRESS=
# 链上会费读取失败时的后端备用值，实际金额由 Gateway 的 membershipFee 决定。示例：1 MON = 1000000000000000000 wei
MEMBERSHIP_FEE_WEI=1000000000000000000
# 后端确认入会交易前要求的区块确认数。示例：1
MEMBERSHIP_MIN_CONFIRMATIONS=1
# FanoraMembershipGateway 部署地址。示例：0x1234...abcd
MEMBERSHIP_PAYMENT_CONTRACT_ADDRESS=
# FanoraMembershipIdentity 部署地址。示例：0x2345...bcde
MEMBERSHIP_IDENTITY_CONTRACT_ADDRESS=
# FanoraCollectibles 部署地址。示例：0x3456...cdef
COLLECTIBLES_CONTRACT_ADDRESS=
# 开始扫描会员身份合约事件的区块号。示例：部署交易所在区块号 123456
MEMBERSHIP_IDENTITY_START_BLOCK=0
# 开始扫描收藏品合约事件的区块号。示例：部署交易所在区块号 123456
COLLECTIBLES_START_BLOCK=0
# 后端链上写操作等待的确认数。示例：1
CHAIN_WRITE_CONFIRMATIONS=1
# 平台资金管理员钱包私钥，仅供后端发起合约提现；绝不是用户私钥。示例：0x + 64 位十六进制测试网私钥
MEMBERSHIP_TREASURY_MANAGER_PRIVATE_KEY=
# 平台身份铸造运营钱包私钥，仅用于调用 mintIdentity；绝不是用户私钥。示例：0x + 64 位十六进制测试网私钥
IDENTITY_MINTER_PRIVATE_KEY=
# 平台等级运营钱包私钥，仅用于会员等级升级；绝不是用户私钥。示例：0x + 64 位十六进制测试网私钥
IDENTITY_LEVEL_MANAGER_PRIVATE_KEY=
# 平台身份元数据运营钱包私钥，仅用于更新身份 IPFS URI；绝不是用户私钥。示例：0x + 64 位十六进制测试网私钥
IDENTITY_URI_MANAGER_PRIVATE_KEY=
# 平台收藏品类型运营钱包私钥，仅用于创建和管理 Token 类型；绝不是用户私钥。示例：0x + 64 位十六进制测试网私钥
COLLECTIBLE_TYPE_MANAGER_PRIVATE_KEY=
# 平台收藏品铸造运营钱包私钥，仅用于发放收藏品；绝不是用户私钥。示例：0x + 64 位十六进制测试网私钥
COLLECTIBLE_MINTER_PRIVATE_KEY=
# 平台收藏品元数据运营钱包私钥，仅用于更新收藏品 IPFS URI；绝不是用户私钥。示例：0x + 64 位十六进制测试网私钥
COLLECTIBLE_URI_MANAGER_PRIVATE_KEY=
# Pinata API JWT，用于上传会员等级图片和 NFT metadata 到 IPFS。示例：Pinata Dashboard 生成的 eyJhbGci...；不要提交真实值
PINATA_JWT=

# 日志最低级别。示例：DEBUG；生产环境建议 INFO
LOG_LEVEL=DEBUG
# 日志格式，可选 console 或 json。示例：console
LOG_FORMAT=console
# 默认接口限流规则。示例：200 per hour
RATE_LIMIT_DEFAULT=200 per hour
# AI Agent 接口限流规则。示例：30 per minute
RATE_LIMIT_AGENT=30 per minute
# 健康检查接口限流规则。示例：60 per minute
RATE_LIMIT_HEALTH=60 per minute
# 登录鉴权接口限流规则。示例：20 per minute
RATE_LIMIT_AUTH=20 per minute

# Docker Compose PostgreSQL 数据库名。示例：fanora
POSTGRES_DB=fanora
# Docker Compose PostgreSQL 用户名。示例：fanora
POSTGRES_USER=fanora
# Docker Compose PostgreSQL 密码，仅用于本地示例，部署时必须替换。示例：请使用强密码
POSTGRES_PASSWORD=fanora-local-password
# 容器启动时是否自动执行数据库迁移。示例：true
RUN_MIGRATIONS=true
