# Application
APP_NAME=Fanora API
VERSION=0.2.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INTERNAL_API_KEY=
WEB3AUTH_CLIENT_ID=BICxTe9MSpkkwRIrgNGa8cGgksO4VvNiBHqt694T88J_WecKTHn474CmkEtFvaOqfE0CxrtZUmUoZCPYiOf8r88
WEB3AUTH_JWKS_URL=https://api-auth.web3auth.io/jwks
WEB3AUTH_ISSUER=https://api-auth.web3auth.io
WEB3AUTH_EXTERNAL_ISSUERS=metamask,wallet-connect-v2,coinbase
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=604800

# Database: use Supabase/PostgreSQL in deployed environments
DATABASE_URL=sqlite+aiosqlite:///./fanora.db
# Local Docker alternative:
# DATABASE_URL=postgresql+psycopg://fanora:fanora-local-password@127.0.0.1:5432/fanora
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=60
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_CONNECT_TIMEOUT_SECONDS=60
DATABASE_KEEPALIVE_IDLE_SECONDS=30
DATABASE_KEEPALIVE_INTERVAL_SECONDS=10
DATABASE_KEEPALIVE_COUNT=3
AUTO_CREATE_SCHEMA=true
MIGRATION_MAX_ATTEMPTS=5
MIGRATION_RETRY_DELAY_SECONDS=2

# Optional LangGraph PostgreSQL checkpoint persistence
CHECKPOINT_DATABASE_URL=
CHECKPOINT_POOL_SIZE=5
CHECKPOINT_AUTO_SETUP=false

# Optional Valkey/Redis cache and distributed rate limiting
CACHE_URL=
CACHE_TTL_SECONDS=60
GRAFANA_ADMIN_PASSWORD=change-this-local-password

# OpenAI or any OpenAI-compatible third-party API
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_FALLBACK_MODELS=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_MAX_RETRIES=3
LLM_TOTAL_TIMEOUT_SECONDS=60
BADGE_DRAFT_MIN_TOKENS=500

# Optional Langfuse tracing
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Monad
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MEMBERSHIP_TREASURY_ADDRESS=
MEMBERSHIP_FEE_WEI=1000000000000000000
MEMBERSHIP_MIN_CONFIRMATIONS=1
BADGE_CONTRACT_ADDRESS=
OPERATOR_PRIVATE_KEY=

# Logging and limits
LOG_LEVEL=DEBUG
LOG_FORMAT=console
RATE_LIMIT_DEFAULT=200 per hour
RATE_LIMIT_AGENT=30 per minute
RATE_LIMIT_HEALTH=60 per minute
RATE_LIMIT_AUTH=20 per minute

# Docker Compose database defaults
POSTGRES_DB=fanora
POSTGRES_USER=fanora
POSTGRES_PASSWORD=fanora-local-password
RUN_MIGRATIONS=true
