{
  "name": "@fanora/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile && hardhat run scripts/export-abis.ts",
    "test": "hardhat test",
    "export:abis": "hardhat run scripts/export-abis.ts",
    "deploy:testnet": "hardhat run --no-compile scripts/deploy.ts --network monadTestnet",
    "redeploy:gateway:testnet": "hardhat run --no-compile scripts/redeploy-gateway.ts --network monadTestnet",
    "deploy:identity:testnet": "hardhat run --no-compile scripts/deploy-identity.ts --network monadTestnet",
    "deploy:collectibles:testnet": "hardhat run --no-compile scripts/deploy-collectibles.ts --network monadTestnet",
    "sync:testnet": "ts-node scripts/sync-deployment.ts monadTestnet",
    "verify:testnet": "hardhat run --no-compile scripts/verify-deployment.ts --network monadTestnet",
    "release:testnet": "npm test && npm run compile && npm run deploy:testnet && npm run sync:testnet && npm run verify:testnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.2.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
