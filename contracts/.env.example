# Fanora 合约部署环境变量模板。私钥仅属于平台部署或运营钱包，绝不能填写任何用户钱包私钥。

# Monad RPC 节点地址。示例：https://testnet-rpc.monad.xyz
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Monad Testnet 链 ID。示例：10143
MONAD_CHAIN_ID=10143
# 初始入会费用，单位 wei；部署后仍可由资金管理员修改。示例：1 MON
MEMBERSHIP_FEE_WEI=1000000000000000000
# 需要写入身份合约的等级 rank，与 membership_levels.rank 保持一致。示例：普通等级 1-6，加管理等级 100
MEMBERSHIP_LEVEL_RANKS=1,2,3,4,5,6,100
# 平台部署钱包私钥，仅在部署合约时签名；绝不是用户私钥。示例：0x + 64 位十六进制测试网私钥
DEPLOYER_PRIVATE_KEY=
# 合约最高管理员地址，建议使用多签钱包。示例：0x1234...abcd
CONTRACT_ADMIN_ADDRESS=
# 入会资金最终接收地址，不是私钥。示例：0x2345...bcde
MEMBERSHIP_TREASURY_ADDRESS=
# 可调用 Gateway 提现方法的平台运营钱包地址。示例：0x3456...cdef
TREASURY_MANAGER_ADDRESS=
# 可暂停或恢复入会付款合约的平台运营钱包地址。示例：0x4567...def0
GATEWAY_PAUSER_ADDRESS=
# 可铸造会员身份 NFT 的平台运营钱包地址。示例：0x5678...ef01
IDENTITY_MINTER_ADDRESS=
# 可升级会员等级的平台运营钱包地址。示例：0x6789...f012
IDENTITY_LEVEL_MANAGER_ADDRESS=
# 可更新会员身份 IPFS metadata 的平台运营钱包地址。示例：0x789a...0123
IDENTITY_URI_MANAGER_ADDRESS=
# 可暂停或恢复会员身份合约的平台运营钱包地址。示例：0x89ab...1234
IDENTITY_PAUSER_ADDRESS=
# 可创建和管理收藏品类型的平台运营钱包地址。示例：0x9abc...2345
COLLECTIBLE_TYPE_MANAGER_ADDRESS=
# 可为用户发放收藏品的平台运营钱包地址。示例：0xabcd...3456
COLLECTIBLE_MINTER_ADDRESS=
# 可更新收藏品 IPFS metadata 的平台运营钱包地址。示例：0xbcde...4567
COLLECTIBLE_URI_MANAGER_ADDRESS=
# 可暂停或恢复收藏品合约的平台运营钱包地址。示例：0xcdef...5678
COLLECTIBLE_PAUSER_ADDRESS=
